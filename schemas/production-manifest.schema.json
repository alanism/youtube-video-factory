{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alanism/youtube-video-factory/schemas/production-manifest.schema.json",
  "title": "YouTube Video Factory Production Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "ontologyVersion",
    "id",
    "title",
    "briefHash",
    "approval",
    "output",
    "release",
    "renditions",
    "designPack",
    "design",
    "autonomy",
    "audio",
    "providers",
    "scenes"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "ontologyVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "briefHash": { "$ref": "#/$defs/hash" },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "approved"] },
        "approvedHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["width", "height", "fps", "quality", "codec", "audioCodec", "destination"],
      "properties": {
        "width": { "const": 1920 },
        "height": { "const": 1080 },
        "fps": { "enum": [24, 30, 60] },
        "quality": { "enum": ["draft", "standard", "high"] },
        "codec": { "const": "h264" },
        "audioCodec": { "const": "aac" },
        "destination": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["version", "keyMessage", "learnerOutcome", "qualityGate"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "keyMessage": { "type": "string", "minLength": 1 },
        "learnerOutcome": { "type": "string", "minLength": 1 },
        "qualityGate": {
          "type": "object",
          "required": ["rubricMinimum", "minimumCriterionScore", "maxRepairCycles", "blockers"],
          "properties": {
            "rubricMinimum": { "type": "number", "minimum": 40 },
            "minimumCriterionScore": { "type": "number", "minimum": 3 },
            "maxRepairCycles": { "type": "integer", "minimum": 0, "maximum": 3 },
            "blockers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "renditions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "aspectRatio", "width", "height", "templateFamily", "templateSource", "defaultTemplate", "destination"],
        "properties": {
          "id": { "enum": ["landscape-16x9", "portrait-9x16"] },
          "aspectRatio": { "enum": ["16:9", "9:16"] },
          "width": { "enum": [1920, 1080] },
          "height": { "enum": [1080, 1920] },
          "templateFamily": { "enum": ["ucc-youtube", "ucc-portrait"] },
          "templateSource": { "type": "string", "minLength": 1 },
          "defaultTemplate": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 }
        }
      }
    },
    "designPack": { "type": "string", "minLength": 1 },
    "design": { "type": "object", "required": ["pack", "palette", "typography", "motion"] },
    "autonomy": { "enum": ["manual", "review-gated", "approved-batch"] },
    "audio": {
      "type": "object",
      "required": ["music", "soundEffects", "captions", "narrationAuthority"],
      "properties": { "narrationAuthority": { "enum": ["elevenlabs", "heygen", "existing", "none"] } }
    },
    "providers": {
      "type": "object",
      "required": ["allowed", "costCeilingUsd", "paidPilotRequired"],
      "properties": {
        "openrouter": {
          "type": "object",
          "required": ["model", "resolution", "generateAudio", "motionContract"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "resolution": { "enum": ["480p", "720p", "1080p"] },
            "generateAudio": { "type": "boolean" },
            "motionContract": { "enum": ["panel-sequence-1-2-3-4", "custom"] }
          }
        },
        "heygen": {
          "type": "object",
          "required": ["mode", "avatarId", "engine", "audioAuthority", "alphaRequired"],
          "properties": {
            "mode": { "enum": ["required", "optional", "disabled"] },
            "avatarId": { "type": "string", "minLength": 1 },
            "engine": { "enum": ["avatar_iii", "avatar_iv"] },
            "audioAuthority": { "enum": ["elevenlabs", "heygen"] },
            "voiceId": { "type": "string" },
            "alphaRequired": { "type": "boolean" }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "layout", "durationSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "layout": { "type": "string", "minLength": 1 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
