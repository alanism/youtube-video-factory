{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alanism/youtube-video-factory/schemas/production-manifest.schema.json",
  "title": "YouTube Video Factory Production Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "ontologyVersion",
    "id",
    "title",
    "briefHash",
    "approval",
    "output",
    "designPack",
    "design",
    "autonomy",
    "audio",
    "providers",
    "scenes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ontologyVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "briefHash": { "$ref": "#/$defs/hash" },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "approved"] },
        "approvedHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["width", "height", "fps", "quality", "codec", "audioCodec", "destination"],
      "properties": {
        "width": { "const": 1920 },
        "height": { "const": 1080 },
        "fps": { "enum": [24, 30, 60] },
        "quality": { "enum": ["draft", "standard", "high"] },
        "codec": { "const": "h264" },
        "audioCodec": { "const": "aac" },
        "destination": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "designPack": { "type": "string", "minLength": 1 },
    "design": { "type": "object", "required": ["pack", "palette", "typography", "motion"] },
    "autonomy": { "enum": ["manual", "review-gated", "approved-batch"] },
    "audio": { "type": "object", "required": ["music", "soundEffects", "captions", "narrationAuthority"] },
    "providers": { "type": "object", "required": ["allowed", "costCeilingUsd", "paidPilotRequired"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "layout", "durationSeconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "layout": { "type": "string", "minLength": 1 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
