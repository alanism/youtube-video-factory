{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alanism/youtube-video-factory/schemas/change-request.schema.json",
  "title": "YouTube Video Factory Change Request",
  "type": "object",
  "required": ["schemaVersion", "id", "projectId", "base", "changes", "preserve", "references", "providerRegeneration", "output", "acceptanceCriteria", "modelRecommendation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "projectId": { "type": "string", "minLength": 1 },
    "base": { "type": "object", "required": ["manifestPath", "manifestHash"], "properties": { "manifestPath": { "type": "string" }, "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "outputPath": { "type": "string" }, "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "changes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["category", "instruction"], "properties": { "category": { "enum": ["visual-design", "copy-captions", "presenter", "narration", "images", "motion-timing", "provider-settings", "output-format", "other"] }, "instruction": { "type": "string", "minLength": 1 }, "sceneIds": { "type": "array", "items": { "type": "string" } } } } },
    "preserve": { "type": "object", "required": ["images", "narration", "captions", "avatar", "motion", "timings"], "properties": { "images": { "type": "boolean" }, "narration": { "type": "boolean" }, "captions": { "type": "boolean" }, "avatar": { "type": "boolean" }, "motion": { "type": "boolean" }, "timings": { "type": "boolean" } } },
    "references": { "type": "array", "items": { "type": "string" } },
    "providerRegeneration": { "enum": ["forbidden", "approved"] },
    "output": { "type": "object", "required": ["versionLabel", "destination"], "properties": { "versionLabel": { "type": "string" }, "destination": { "type": "string" } } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "modelRecommendation": { "type": "object", "required": ["tier", "reasoning", "rationale"], "properties": { "tier": { "enum": ["luna", "terra", "sol"] }, "reasoning": { "enum": ["low", "medium", "high"] }, "rationale": { "type": "string" } } }
  }
}
